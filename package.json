{
  "name": "vps-dashboard",
  "version": "1.0.0",
  "description": "VPS Dashboard avec moteur de benchmark d'agents — batterie de 60 tests + rapports corrélés",
  "type": "module",
  "workspaces": [
    "benchmark",
    "dashboard"
  ],
  "scripts": {
    "bench": "tsx benchmark/runner/cli.ts",
    "bench:mock": "tsx benchmark/runner/cli.ts --mock",
    "report": "tsx benchmark/report/cli.ts",
    "dev": "tsx api/server.ts",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
